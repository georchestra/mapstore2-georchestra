<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"

	   xmlns:cxf="http://cxf.apache.org/core"
	   xmlns:jaxws="http://cxf.apache.org/jaxws"
       xmlns:jaxrs="http://cxf.apache.org/jaxrs"

       xsi:schemaLocation="
            http://www.springframework.org/schema/beans     http://www.springframework.org/schema/beans/spring-beans.xsd
            http://cxf.apache.org/jaxws                     http://cxf.apache.org/schemas/jaxws.xsd
            http://cxf.apache.org/jaxrs                     http://cxf.apache.org/schemas/jaxrs.xsd
            http://cxf.apache.org/core                      http://cxf.apache.org/schemas/core.xsd
            http://www.springframework.org/schema/context   http://www.springframework.org/schema/context/spring-context.xsd"
       default-autowire="byName">

    <context:annotation-config />

    <bean id="geostoreInitializer" class="it.geosolutions.geostore.init.GeoStoreInit" lazy-init="false">
        <!-- Site specific initialization. Please specify a path in the ovr file-->
        <property name="categoryListInitFile" value="classpath:sample_categories.xml" />

        <!-- Site specific initialization. Please specify a path in the ovr file-->
        <property name="userGroupListInitFile" value="classpath:sample_groups.xml" />
        <!-- The default password encoder -->
        <property name="passwordEncoder" ref="${passwordEncoderUsed}"></property>
    </bean>

    <bean id="georchestra-properties" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <!-- Resolve geOrchestra placeholders before GeoStore applies fallback defaults. -->
        <property name="order" value="-10"/>
        <property name="locations">
            <list>
                <value>classpath:geostore.properties</value>
                <value>classpath*:geostore.properties</value>
                <value>classpath:mapstore.properties</value>
                <value>classpath:ldap.properties</value>
                <value>file:${datadir.location:}/mapstore.properties</value>
                <value>file:${datadir.location:}/ldap.properties</value>
                <value>file:${georchestra.datadir:}/default.properties</value>
                <value>file:${georchestra.datadir:}/mapstore/geostore.properties</value>
            </list>
        </property>
        <property name="ignoreResourceNotFound" value="true"/>
        <property name="ignoreUnresolvablePlaceholders" value="true"/>
    </bean>
    <!-- External bean overrides (e.g. oidc_providers) run before the placeholder configurers,
         so their values can use placeholders, resolved like the ones of default.properties.
         The database connection is not read from here: as for the other geOrchestra
         applications it comes from the pgsql* properties of default.properties, and the
         schema from mapstore/geostore.properties. -->
    <bean class="org.springframework.beans.factory.config.PropertyOverrideConfigurer">
        <property name="ignoreResourceNotFound" value="true"/>
        <property name="ignoreInvalidKeys" value="true"/>
        <property name="order" value="-20"/>
        <property name="locations">
            <list>
                <value>classpath:mapstore-ovr.properties</value>
                <value>file:${georchestra.datadir:}/mapstore/mapstore-ovr.properties</value>
            </list>
        </property>
    </bean>
    <bean id="geostoreDataSource" class="org.apache.commons.dbcp2.BasicDataSource">
        <property name="driverClassName" value="org.postgresql.Driver" />
        <property name="url" value="jdbc:postgresql://${pgsqlHost:localhost}:${pgsqlPort:5432}/${pgsqlDatabase:georchestra}" />
        <property name="username" value="${pgsqlUser:postgres}" />
        <property name="password" value="${pgsqlPassword:}" />
        <property name="initialSize" value="${dataSource.initialSize:0}" />
        <property name="minIdle" value="${dataSource.minIdle:0}" />
        <property name="maxIdle" value="${dataSource.maxIdle:8}" />
        <property name="minEvictableIdleTimeMillis" value="${dataSource.minEvictableIdleTimeMillis:180000}" />
        <property name="timeBetweenEvictionRunsMillis" value="${dataSource.timeBetweenEvictionRunsMillis:3000}" />
    </bean>
    <bean id="geostoreEntityManagerFactory"
                class="org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean">
        <property name="persistenceUnitName" value="geostore" />
        <property name="persistenceXmlLocation" value="classpath:META-INF/geostore-persistence.xml" />
        <property name="dataSource" ref="geostoreDataSource" />
        <property name="jpaVendorAdapter" ref="geostoreVendorAdapter" />
        <property name="jpaPropertyMap">
            <map>
                <entry key="hibernate.connection.autocommit" value="true"/>
                <entry key="hibernate.generate_statistics" value="false"/>
                <entry key="hibernate.hbm2ddl.auto" value="${georchestra.hibernate.ddlAuto:update}" />
                <entry key="hibernate.id.db_structure_naming_strategy" value="legacy"/>
                <entry key="hibernate.default_schema" value="${pgsqlGeoStoreSchema:geostore}" />
            </map>
        </property>
    </bean>

    <bean id="geostoreVendorAdapter"
                class="org.springframework.orm.jpa.vendor.HibernateJpaVendorAdapter">
        <property name="databasePlatform" value="org.hibernate.dialect.PostgreSQLDialect" />
        <property name="showSql" value="false" />
        <property name="generateDdl" value="true" />
    </bean>
    <alias name="geostoreDataSource" alias="georchestraDataSource"/>
    <alias name="geostoreEntityManagerFactory" alias="georchestraEntityManagerFactory"/>
    <alias name="geostoreVendorAdapter" alias="georchestraVendorAdapter"/>
    <!-- GeoStore's DAO context is discovered before these external-user aliases. -->
    <alias name="ldapUserGroupDAO" alias="userGroupDAO"/>
    <alias name="ldapUserDAO" alias="userDAO"/>
    <alias name="externalSecurityDAO" alias="securityDAO"/>
</beans>
